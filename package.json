{
  "name": "my-ai-journey-checks",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation checks for a Java-first AI learning repository",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "markdownlint-cli2",
    "links": "node scripts/check-links.mjs",
    "links:external": "node scripts/check-links.mjs --external",
    "test:java": "node scripts/test-java.mjs",
    "test": "npm run format:check && npm run lint && npm run links && npm run test:java"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.2",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9"
  }
}
